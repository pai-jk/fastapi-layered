{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: FastAPI",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "webapp.app:create_app",
                "--factory",
                "--host",
                "0.0.0.0",
                "--port",
                "8000",
                "--reload",
                "--no-access-log",
                "--log-level",
                "debug",
                "--no-server-header"
            ],
            "console": "integratedTerminal",
            "python": "${workspaceFolder}/.venv/bin/python",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src",
                "APP_ENV": "dev",
                "DB_TYPE": "sqlite+aiosqlite:///./app_db.db",
                "DB_NAME": "app_db.db",
                # SQLite는 host, port, user, password가 필요 없지만 Pydantic 검증을 통과하기 위해 더미 값을 넣어둡니다.
                "DB_HOST": "localhost",
                "DB_PORT": "0",
                "DB_USER": "admin",
                "DB_PASSWORD": "password",
                "DB_ECHO": "True"
            }
        },
    ]
}